# =============================================================================
# AI Product Costing Accelerator — deployment configuration
# =============================================================================
# Copy this file to `config.env` and fill in your values.
# `config.env` is gitignored — never commit it.
#
#   cp config.env.example config.env
#   bash setup.sh      # one-time Snowflake setup
#   bash deploy.sh     # build + deploy the SPCS service
#
# =============================================================================

# Snowflake CLI connection name (from ~/.snowflake/connections.toml).
APC_CONNECTION="internal-marketplace"
