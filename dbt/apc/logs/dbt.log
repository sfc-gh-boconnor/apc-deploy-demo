    from APC_DEPLOY_DB.DBT_ANALYTICS.stg_cost_components c
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_fx_rates f
           on f.from_currency = c.local_currency
          and f.rate_year     = c.fiscal_year
