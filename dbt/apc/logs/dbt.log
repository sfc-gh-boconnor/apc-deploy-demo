[0m17:03:59.927071 [debug] [Thread-3 (]: On model.apc.int_bom_costed: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "default", "target_name": "dev", "node_id": "model.apc.int_bom_costed"} */
create dynamic table APC_DEPLOY_DB.DBT_ANALYTICS.int_bom_costed
        target_lag = 'downstream'
        warehouse = APC_DEPLOY_WH
        refresh_mode = AUTO

        initialize = ON_CREATE

        as (
            -- Intermediate: costed BOM — material cost + conversion cost per component at each level.
-- Co-authored with CoCo

with exploded as (
    select * from APC_DEPLOY_DB.DBT_ANALYTICS.int_bom_explosion
),

-- Material cost: standard price of each leaf component × effective qty
material_costs as (
    select
        e.root_material,
        e.plant_code,
        e.component_material,
        e.bom_level,
        e.effective_qty_per,
        sp.standard_price_local,
        fx.usd_per_unit,
        e.effective_qty_per * sp.standard_price_local * coalesce(fx.usd_per_unit, 1) as material_cost_usd
    from exploded e
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_standard_price sp
        on e.component_material = sp.material_number
        and e.plant_code = sp.plant_code
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_plant p
        on e.plant_code = p.plant_code
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_fx_rates fx
        on p.local_currency = fx.from_currency
    where e.component_type in ('ROH', 'HALB')  -- raw + semi-finished
),

-- Conversion cost: routing activity × activity rate for each parent
conversion_costs as (
    select
        e.root_material,
        e.plant_code,
        e.parent_material,
        e.bom_level,
        r.activity_type_1,
        r.activity_qty_1,
        ar.total_rate as rate_1,
        r.activity_type_2,
        r.activity_qty_2,
        ar2.total_rate as rate_2,
        coalesce(r.activity_qty_1 * ar.total_rate, 0)
            + coalesce(r.activity_qty_2 * ar2.total_rate, 0) as conversion_cost_local,
        fx.usd_per_unit,
        (coalesce(r.activity_qty_1 * ar.total_rate, 0)
            + coalesce(r.activity_qty_2 * ar2.total_rate, 0))
            * coalesce(fx.usd_per_unit, 1)  as conversion_cost_usd
    from exploded e
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_routings r
        on e.parent_material = r.material_number
        and e.plant_code = r.plant_code
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_activity_rates ar
        on r.cost_centre = ar.cost_centre
        and r.activity_type_1 = ar.activity_type
        and ar.rate_type = 1  -- plan rate
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_activity_rates ar2
        on r.cost_centre = ar2.cost_centre
        and r.activity_type_2 = ar2.activity_type
        and ar2.rate_type = 1
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_plant p
        on e.plant_code = p.plant_code
    left join APC_DEPLOY_DB.DBT_ANALYTICS.stg_fx_rates fx
        on p.local_currency = fx.from_currency
)

select
    mc.root_material,
    mc.plant_code,
    mc.component_material,
    mc.bom_level,
    mc.effective_qty_per,
    mc.material_cost_usd,
    coalesce(cc.conversion_cost_usd, 0) as conversion_cost_usd,
    mc.material_cost_usd + coalesce(cc.conversion_cost_usd, 0) as total_component_cost_usd,
    'material'  as cost_type
from material_costs mc
left join conversion_costs cc
    on mc.root_material = cc.root_material
    and mc.plant_code = cc.plant_code
    and mc.component_material = cc.parent_material

union all

select
    cc.root_material,
    cc.plant_code,
    cc.parent_material as component_material,
    cc.bom_level,
    null as effective_qty_per,
    0 as material_cost_usd,
    cc.conversion_cost_usd,
    cc.conversion_cost_usd as total_component_cost_usd,
    'conversion' as cost_type
from conversion_costs cc
where cc.conversion_cost_usd > 0
        )
